# Soroban Network Configuration
SOROBAN_RPC_URL=https://rpc-futurenet.stellar.org
# Optional comma-separated regional RPC endpoints for automated failover.
# SOROBAN_RPC_URLS=https://rpc-us.example.com,https://rpc-eu.example.com
NETWORK_PASSPHRASE=Test SDF Future Network ; October 2022

# Multi-region failover tuning
RPC_FAILOVER_ENABLED=true
RPC_FAILOVER_FAILURE_THRESHOLD=3
RPC_FAILOVER_COOLDOWN_MS=30000
RPC_FAILOVER_HEALTH_CHECK_INTERVAL_MS=15000

# Keeper Account Secret (Placeholder - DO NOT commit actual secrets)
KEEPER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# SoroTask Contract ID (Placeholder - DO NOT commit actual addresses)
CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Polling Configuration
POLLING_INTERVAL_MS=10000
MAX_CONCURRENT_READS=10
MAX_CONCURRENT_EXECUTIONS=3
METRICS_PORT=3000
HEALTH_STALE_THRESHOLD_MS=60000

# Secret Store Integration (AWS Secrets Manager or HashiCorp Vault)
# SECRET_STORE_PROVIDER=aws # or 'vault'
# AWS_SECRETS_MANAGER_SECRET_ID=sorotask/keeper/production
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_SECRET_PATH=secret/data/sorotask/keeper

# Keeper Admin API Token (Placeholder)
KEEPER_ADMIN_TOKEN=your_sanitized_admin_token_here

# Fraud / anomaly alerting
# FRAUD_ALERT_WEBHOOK_URL=https://alerts.example.com/keeper-fraud
# FRAUD_ALERT_DEBOUNCE_MS=600000

# Work partitioning / sharding
KEEPER_SHARD_INDEX=0
KEEPER_SHARD_COUNT=1

# P2P keeper discovery and load sharing
P2P_ENABLED=false
P2P_LISTEN_HOST=0.0.0.0
P2P_LISTEN_PORT=4100

# Task Registry Configuration
START_LEDGER=0
WAIT_FOR_CONFIRMATION=true
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
MAX_RETRY_DELAY_MS=30000

# Logging Configuration
LOG_LEVEL=info
NODE_ENV=production
