# Soroban Network Configuration
SOROBAN_RPC_URL=https://rpc-futurenet.stellar.org
# Optional comma-separated regional RPC endpoints for automated failover.
# SOROBAN_RPC_URLS=https://rpc-us.example.com,https://rpc-eu.example.com
NETWORK_PASSPHRASE=Test SDF Future Network ; October 2022

# Multi-region failover tuning
RPC_FAILOVER_ENABLED=true
RPC_FAILOVER_FAILURE_THRESHOLD=3
RPC_FAILOVER_COOLDOWN_MS=30000
RPC_FAILOVER_HEALTH_CHECK_INTERVAL_MS=15000

# Keeper Account
# Option 1: Plaintext secret (development/testing)
KEEPER_SECRET=S...

# Option 2: HSM-only mode using AWS KMS (private key NEVER leaves KMS)
# KEY_PROVIDER=aws-kms
# KMS_KEY_ID=alias/keeper-key   # or a KMS key ID or ARN
# AWS_KMS_REGION=us-east-1

# Option 3: HSM-only mode using HashiCorp Vault Transit Engine
# KEY_PROVIDER=vault-transit
# VAULT_TRANSIT_KEY_NAME=keeper-key
# VAULT_TRANSIT_PATH=v1/transit

# Multi-sig HSM signing (optional, adds HSM signatures alongside the primary keypair)
# HSM_PROVIDER=mock          # mock | aws-kms | vault-transit (default: mock)
# HSM_KEY_IDS=key-1,key-2   # Comma-separated HSM key IDs for multi-sig
# AWS_KMS_REGION=us-east-1  # KMS region (for HSM_PROVIDER=aws-kms)
# VAULT_TRANSIT_PATH=v1/transit     # Vault transit mount path

# SoroTask Contract
CONTRACT_ID=C...

# Polling Configuration
POLLING_INTERVAL_MS=10000
MAX_CONCURRENT_READS=10
MAX_CONCURRENT_EXECUTIONS=3
METRICS_PORT=3000
HEALTH_STALE_THRESHOLD_MS=60000

# Keeper Admin API
# Required to use /admin/keeper endpoints
# KEEPER_ADMIN_TOKEN=replace-with-strong-random-token

# Fraud / anomaly alerting
# FRAUD_ALERT_WEBHOOK_URL=https://alerts.example.com/keeper-fraud
# FRAUD_ALERT_DEBOUNCE_MS=600000
# FRAUD_BURST_WINDOW_MS=300000
# FRAUD_FAILURE_WINDOW_MS=600000
# FRAUD_ALERT_THRESHOLD=4
# FRAUD_FEE_SPIKE_MULTIPLIER=4
# FRAUD_MIN_FEE_SPIKE=10
# FRAUD_DRAIN_MULTIPLIER=3
# FRAUD_MIN_DRAIN_FEE=50
# FRAUD_TASK_BURST_THRESHOLD=5
# FRAUD_FAILURE_BURST_THRESHOLD=3
# FRAUD_CROSS_TASK_THRESHOLD=8
# FRAUD_CROSS_TASK_FEE_THRESHOLD=100
# FRAUD_ALERT_WEBHOOK_TIMEOUT_MS=5000
# FRAUD_ALERT_MAX_ATTEMPTS=3

# Reconciliation / accounting alerting
# RECONCILIATION_ALERT_WEBHOOK_URL=https://alerts.example.com/keeper-reconciliation
# RECONCILIATION_ALERT_DEBOUNCE_MS=600000
# RECONCILIATION_EXECUTION_SETTLING_MS=120000
# RECONCILIATION_TOLERANCE=0
# RECONCILIATION_ALERT_WEBHOOK_TIMEOUT_MS=5000
# RECONCILIATION_ALERT_MAX_ATTEMPTS=3

# Work partitioning / sharding
KEEPER_SHARD_INDEX=0
KEEPER_SHARD_COUNT=1
# Optional human-readable shard label for logs/metrics
# KEEPER_SHARD_LABEL=keeper-a

# P2P keeper discovery and load sharing
# Disabled by default. When enabled, all P2P messages are HMAC-signed.
P2P_ENABLED=false
# Use a strong shared secret distributed out-of-band to trusted keepers only.
# P2P_SHARED_SECRET=replace-with-strong-random-secret
# Optional stable node ID. Defaults to the keeper public key.
# P2P_NODE_ID=keeper-a
# Public URL other keepers can dial, for example http://keeper-a.example.com:4100
# P2P_PUBLIC_URL=http://127.0.0.1:4100
P2P_LISTEN_HOST=0.0.0.0
P2P_LISTEN_PORT=4100
# Comma-separated peer URLs used only for initial discovery; peers gossip the rest.
# P2P_BOOTSTRAP_PEERS=http://keeper-b.example.com:4100,http://keeper-c.example.com:4100
P2P_HEARTBEAT_INTERVAL_MS=10000
P2P_STALE_PEER_MS=45000
P2P_AUTH_WINDOW_MS=30000
P2P_CONNECT_TIMEOUT_MS=5000
# socketio, libp2p, or hybrid. libp2p requires a runtime libp2p node/factory.
P2P_TRANSPORT=socketio
P2P_TASK_LOCK_TTL_MS=60000

# Recurring execution drift detection thresholds (seconds)
DRIFT_WARNING_SECONDS=60
DRIFT_CRITICAL_SECONDS=300

# Task Registry Configuration
# Ledger to start scanning TaskRegistered events from (0 = auto-detect)
START_LEDGER=0

# Execution Configuration
WAIT_FOR_CONFIRMATION=true

# Retry Configuration
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
MAX_RETRY_DELAY_MS=30000

# Persistent Retry Scheduler Configuration
RETRY_RETENTION_DAYS=7
RETRY_STORAGE_PATH=./data/retries.json
MAX_RETRY_QUEUE_SIZE=100
MAX_RETRIES_PER_CYCLE=2

# Simulation Cache Configuration
SIMULATION_CACHE_TTL=30
SIMULATION_CACHE_MAX_SIZE=1000

# Task Metadata Cache Configuration
# LRU cache for task configurations with event-driven invalidation.
# Cached entries are invalidated instantly when TaskUpdated events arrive
# from the registry, and expire after TTL otherwise.  Reduces redundant
# RPC state queries by up to 75%.
TASK_CACHE_ENABLED=true
TASK_CACHE_TTL_SECONDS=60
TASK_CACHE_MAX_SIZE=2000

# Serverless resolver execution
# Optional JSON file mapping on-chain resolver IDs to sandboxed JS/WASM functions
# RESOLVER_FUNCTIONS_CONFIG=./resolvers.json
RESOLVER_DEFAULT_TIMEOUT_MS=250
# skip = fail closed, allow = fail open after resolver errors
RESOLVER_FAILURE_MODE=skip

# Logging Configuration
LOG_LEVEL=info
NODE_ENV=production

KEEPER_ADMIN_TOKEN=change_me_securely
